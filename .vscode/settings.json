{
    "python.terminal.useEnvFile": true,
    "[python]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        },
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "cSpell.words": [
        "appengine",
        "appspot",
        "artifactregistry",
        "ASGI",
        "cloudbuild",
        "devserver",
        "dotenv",
        "fastapi",
        "gcloudignore",
        "linebot",
        "pytest",
        "redoc"
    ]
}